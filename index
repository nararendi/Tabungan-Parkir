        function fetchDataFromGoogleSheets(silent = false) {
            if (isSyncing) return;

            const icon = document.getElementById('headerSyncIcon');
            if (icon) icon.classList.add('animate-spin');

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                isSyncing = true;
                google.script.run
                    .withSuccessHandler((res) => {
                        isSyncing = false;
                        if (icon) icon.classList.remove('animate-spin');
                        if (res) applyRemoteData(res, silent);
                    })
                    .withFailureHandler((err) => {
                        isSyncing = false;
                        if (icon) icon.classList.remove('animate-spin');
                        console.warn('Native GAS fetch failed:', err);
                    })
                    .fetchAllData();
                return;
            }

            const gasUrl = localStorage.getItem(STORAGE_KEY_GAS) || '';
            if (!gasUrl || !gasUrl.startsWith('http')) {
                if (icon) icon.classList.remove('animate-spin');
                return;
            }

            isSyncing = true;
            fetch(`${gasUrl}?action=getData`)
                .then(res => res.json())
                .then(result => {
                    isSyncing = false;
                    if (icon) icon.classList.remove('animate-spin');
                    if (result && result.status === 'success' && result.data) {
                        applyRemoteData(result.data, silent);
                    }
                })
                .catch(err => {
                    isSyncing = false;
                    if (icon) icon.classList.remove('animate-spin');
                    console.warn('Background GAS Fetch Exception:', err);
                });
        }

        function applyRemoteData(data, silent = false) {
            if (!data) return;

            students = Array.isArray(data.students) ? data.students : [];
            savingsTransactions = Array.isArray(data.savings) ? data.savings : [];
            parkingLogs = Array.isArray(data.parking) ? data.parking : [];
            users = Array.isArray(data.users) && data.users.length > 0 ? data.users : users;

            recalculateStudentBalances();
            renderAllViews();
            renderDashboardChart();

            if (!silent) {
                showToast('Data berhasil diperbarui dari Google Sheets!', 'success');
            }
        }

        async function saveDataToGoogleSheets() {
            isSyncing = true; 
            
            const payloadData = {
                students: students,
                savings: savingsTransactions,
                parking: parkingLogs,
                users: users
            };

            const icon = document.getElementById('headerSyncIcon');
            if (icon) icon.classList.add('animate-spin');

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(() => {
                        isSyncing = false;
                        if (icon) icon.classList.remove('animate-spin');
                    })
                    .withFailureHandler((err) => {
                        isSyncing = false;
                        if (icon) icon.classList.remove('animate-spin');
                        console.warn('Fullspeed GAS Sync error:', err);
                    })
                    .saveAllData(payloadData);
                return;
            }

            const url = localStorage.getItem(STORAGE_KEY_GAS);
            if (!url || !url.startsWith('http')) {
                isSyncing = false;
                if (icon) icon.classList.remove('animate-spin');
                return;
            }

            try {
                await fetch(url, {
                    method: 'POST',
                    mode: 'no-cors',
                    keepalive: true,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: 'syncAll',
                        data: payloadData
                    })
                });
            } catch (err) {
                console.warn('Fullspeed Sync Exception:', err);
            } finally {
                isSyncing = false;
                if (icon) icon.classList.remove('animate-spin');
            }
        }

