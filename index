        // RENDER SAVINGS REPORT WITH 10 GROUPS PER PAGE
        function renderSavingsReport(startDate, endDate) {
            let filtered = [...savingsTransactions];
            if (startDate) filtered = filtered.filter(t => t.date >= startDate);
            if (endDate) filtered = filtered.filter(t => t.date <= endDate);

            const totalSetor = filtered.filter(t => t.type === 'SETOR').reduce((a, b) => a + Number(b.amount || 0), 0);
            const totalTarik = filtered.filter(t => t.type === 'TARIK').reduce((a, b) => a + Number(b.amount || 0), 0);
            const netMutasi = totalSetor - totalTarik;

            document.getElementById('reportSummaryMetrics').innerHTML = `
                <div class="p-3 bg-emerald-50 rounded-lg border border-emerald-200">
                    <p class="text-[11px] font-semibold text-emerald-700">Total Setoran</p>
                    <p class="text-sm font-bold text-emerald-900">${formatRp(totalSetor)}</p>
                </div>
                <div class="p-3 bg-rose-50 rounded-lg border border-rose-200">
                    <p class="text-[11px] font-semibold text-rose-700">Total Penarikan</p>
                    <p class="text-sm font-bold text-rose-900">${formatRp(totalTarik)}</p>
                </div>
                <div class="p-3 bg-indigo-50 rounded-lg border border-indigo-200">
                    <p class="text-[11px] font-semibold text-indigo-700">Net Mutasi Kas</p>
                    <p class="text-sm font-bold text-indigo-900">${formatRp(netMutasi)}</p>
                </div>
            `;

            document.getElementById('reportTableHeader').innerHTML = `
                <tr>
                    <th class="p-2.5 border-b border-slate-300 w-10 text-center"></th>
                    <th class="p-2.5 border-b border-slate-300">Siswa</th>
                    <th class="p-2.5 border-b border-slate-300">Kelas</th>
                    <th class="p-2.5 border-b border-slate-300">Jumlah Transaksi</th>
                    <th class="p-2.5 border-b border-slate-300 text-right">Total Nominal</th>
                </tr>
            `;

            const tbody = document.getElementById('reportTableBody');
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400">Tidak ada data untuk periode ini</td></tr>`;
                document.getElementById('reportTableFooter').innerHTML = '';
                renderPaginationControls('reportPagination', 1, 0, 0, 'changeReportPage');
                return;
            }

            const grouped = {};
            filtered.forEach(t => {
                if (!grouped[t.studentNis]) {
                    grouped[t.studentNis] = {
                        studentName: t.studentName,
                        transactions: []
                    };
                }
                grouped[t.studentNis].transactions.push(t);
            });

            const groupNises = Object.keys(grouped);
            const totalItems = groupNises.length;
            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

            if (currentPageReport > totalPages) currentPageReport = totalPages;

            const startIndex = (currentPageReport - 1) * ITEMS_PER_PAGE;
            const pagedNises = groupNises.slice(startIndex, startIndex + ITEMS_PER_PAGE);

            let html = '';
            for (const nis of pagedNises) {
                const group = grouped[nis];
                const stud = students.find(s => s.nis === nis);
                const cls = stud ? stud.class : '-';
                const safeNis = nis.replace(/\W/g, '');
                const isExpanded = expandedReportGroups.has(safeNis);

                const groupSetor = group.transactions.filter(t => t.type === 'SETOR').reduce((a, b) => a + Number(b.amount || 0), 0);
                const groupTarik = group.transactions.filter(t => t.type === 'TARIK').reduce((a, b) => a + Number(b.amount || 0), 0);
                const groupNet = groupSetor - groupTarik;

                html += `
                <tr class="hover:bg-slate-100 cursor-pointer border-b border-slate-200 bg-slate-50 transition-colors" onclick="toggleReportGroup('${safeNis}')">
                    <td class="p-2.5 text-center w-10">
                        <i data-lucide="chevron-down" id="icon_rep_group_${safeNis}" class="w-4 h-4 text-slate-500 transition-transform ${isExpanded ? '' : '-rotate-90'} inline-block"></i>
                    </td>
                    <td class="p-2.5">
                        <div class="font-bold text-slate-900">${group.studentName}</div>
                        <div class="text-[10px] text-slate-500 font-mono">NIS: ${nis}</div>
                    </td>
                    <td class="p-2.5 font-semibold text-slate-700">${cls}</td>
                    <td class="p-2.5">
                        <span class="px-2.5 py-1 text-[10px] font-bold text-indigo-700 bg-indigo-100/70 rounded-md border border-indigo-200">
                            ${group.transactions.length} Riwayat Transaksi
                        </span>
                    </td>
                    <td class="p-2.5 text-right font-bold ${groupNet >= 0 ? 'text-emerald-600' : 'text-rose-600'}">
                        ${groupNet >= 0 ? '+' : ''}${formatRp(groupNet)}
                    </td>
                </tr>
                `;

                group.transactions.forEach(t => {
                    html += `
                    <tr class="hover:bg-slate-50 child-rep-group-${safeNis} ${isExpanded ? '' : 'hidden'} border-b border-slate-100">
                        <td class="p-2.5 pl-6 font-semibold text-slate-700 text-[11px] border-l-2 border-indigo-200">${t.date}</td>
                        <td class="p-2.5 text-slate-500 text-[11px] italic" colspan="2">Catatan: ${t.note || '-'}</td>
                        <td class="p-2.5">
                            <span class="px-2 py-0.5 text-[10px] font-extrabold rounded ${t.type === 'SETOR' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">
                                ${t.type}
                            </span>
                        </td>
                        <td class="p-2.5 text-right font-bold ${t.type === 'SETOR' ? 'text-emerald-600' : 'text-rose-600'}">
                            ${t.type === 'SETOR' ? '+' : '-'}${formatRp(t.amount)}
                        </td>
                    </tr>
                    `;
                });
            }

            tbody.innerHTML = html;

            document.getElementById('reportTableFooter').innerHTML = `
                <tr>
                    <td colspan="4" class="p-2.5 text-right font-bold">NET MUTASI Kas Periode:</td>
                    <td class="p-2.5 text-right font-extrabold ${netMutasi >= 0 ? 'text-emerald-700' : 'text-rose-700'}">${formatRp(netMutasi)}</td>
                </tr>
            `;

            renderPaginationControls('reportPagination', currentPageReport, totalPages, totalItems, 'changeReportPage');
            safeLucide();
        }

        function toggleReportGroup(safeNis) {
            const rows = document.querySelectorAll(`.child-rep-group-${safeNis}`);
            const icon = document.getElementById(`icon_rep_group_${safeNis}`);
            let isHidden = false;
            
            rows.forEach(row => {
                if (row.classList.contains('hidden')) {
                    row.classList.remove('hidden');
                    isHidden = true;
                } else {
                    row.classList.add('hidden');
                }
            });

            if (isHidden) {
                expandedReportGroups.add(safeNis);
                if (icon) icon.classList.remove('-rotate-90');
            } else {
                expandedReportGroups.delete(safeNis);
                if (icon) icon.classList.add('-rotate-90');
            }
        }

        // RENDER RECAP PER STUDENT REPORT WITH 10 ROWS PER PAGE
        function renderStudentRecapReport(startDate, endDate) {
            const nis = document.getElementById('repStudentSelect')?.value;
            const student = students.find(s => s.nis === nis);

            if (!student) {
                document.getElementById('repSubTitle').innerText = 'Rekapitulasi Tabungan Per Siswa - Silakan Pilih Siswa';
                document.getElementById('reportSummaryMetrics').innerHTML = `
                    <div class="col-span-1 sm:col-span-3 p-4 bg-amber-50 rounded-xl border border-amber-200 text-amber-800 text-xs text-center font-bold">
                        Silakan pilih Kelas dan Siswa pada filter di atas untuk menampilkan seluruh rekapitulasi transaksi tabungan.
                    </div>
                `;
                document.getElementById('reportTableHeader').innerHTML = '';
                document.getElementById('reportTableBody').innerHTML = '<tr><td colspan="7" class="p-4 text-center text-slate-400">Silakan pilih siswa terlebih dahulu</td></tr>';
                document.getElementById('reportTableFooter').innerHTML = '';
                renderPaginationControls('reportPagination', 1, 0, 0, 'changeReportPage');
                return;
            }

            const periodStr = (startDate && endDate) ? `Periode: ${startDate} s.d ${endDate}` : 'Periode: Semua Waktu';
            document.getElementById('repSubTitle').innerText = `Buku Tabungan Siswa: ${student.name} (NIS: ${student.nis} • Kelas: ${student.class}) - ${periodStr}`;

            let allStudentTxs = savingsTransactions.filter(t => t.studentNis === student.nis)
                .sort((a, b) => new Date(a.date) - new Date(b.date));

            let openingBalance = 0;
            if (startDate) {
                const priorTxs = allStudentTxs.filter(t => t.date < startDate);
                openingBalance = priorTxs.reduce((acc, t) => acc + (t.type === 'SETOR' ? Number(t.amount || 0) : -Number(t.amount || 0)), 0);
            }

            let filteredTxs = allStudentTxs;
            if (startDate) filteredTxs = filteredTxs.filter(t => t.date >= startDate);
            if (endDate) filteredTxs = filteredTxs.filter(t => t.date <= endDate);

            let totalSetor = 0;
            let totalTarik = 0;
            let currentRunBal = openingBalance;

            // Pre-calculate running balance for all rows to ensure accuracy across pages
            const rowsData = filteredTxs.map((t, idx) => {
                const amt = Number(t.amount || 0);
                if (t.type === 'SETOR') {
                    totalSetor += amt;
                    currentRunBal += amt;
                } else {
                    totalTarik += amt;
                    currentRunBal -= amt;
                }
                return {
                    tx: t,
                    index: idx + 1,
                    runBal: currentRunBal
                };
            });

            const netMutasi = totalSetor - totalTarik;
            const endingBalance = currentRunBal;

            document.getElementById('reportSummaryMetrics').innerHTML = `
                <div class="p-3 bg-indigo-50 rounded-lg border border-indigo-200">
                    <p class="text-[11px] font-semibold text-indigo-700">Profil Siswa</p>
                    <p class="text-sm font-bold text-indigo-900 truncate">${student.name}</p>
                    <p class="text-[10px] text-indigo-600 font-semibold mt-0.5">NIS: ${student.nis} • Kelas: ${student.class}</p>
                </div>
                <div class="p-3 bg-emerald-50 rounded-lg border border-emerald-200">
                    <p class="text-[11px] font-semibold text-emerald-700">Mutasi Periode Ini</p>
                    <p class="text-sm font-bold text-emerald-900">+${formatRp(totalSetor)}</p>
                    <p class="text-[10px] text-rose-600 font-semibold mt-0.5">Tarik: -${formatRp(totalTarik)} (Net: ${formatRp(netMutasi)})</p>
                </div>
                <div class="p-3 bg-slate-900 text-white rounded-lg border border-slate-800">
                    <p class="text-[11px] font-semibold text-slate-300">Saldo Akhir Periode</p>
                    <p class="text-sm font-bold text-emerald-400">${formatRp(endingBalance)}</p>
                    <p class="text-[10px] text-slate-400 font-semibold mt-0.5">Saldo Awal: ${formatRp(openingBalance)} • Net Mutasi: ${netMutasi >= 0 ? '+' : ''}${formatRp(netMutasi)}</p>
                </div>
            `;

            document.getElementById('reportTableHeader').innerHTML = `
                <tr>
                    <th class="p-2.5 border-b border-slate-300 text-center">No</th>
                    <th class="p-2.5 border-b border-slate-300">Tanggal</th>
                    <th class="p-2.5 border-b border-slate-300">Jenis Transaksi</th>
                    <th class="p-2.5 border-b border-slate-300 text-right">Setor (Kredit)</th>
                    <th class="p-2.5 border-b border-slate-300 text-right">Tarik (Debit)</th>
                    <th class="p-2.5 border-b border-slate-300 text-right">Saldo Kumulatif</th>
                    <th class="p-2.5 border-b border-slate-300">Catatan</th>
                </tr>
            `;

            const totalItems = rowsData.length;
            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

            if (currentPageReport > totalPages) currentPageReport = totalPages;

            const startIndex = (currentPageReport - 1) * ITEMS_PER_PAGE;
            const pagedRows = rowsData.slice(startIndex, startIndex + ITEMS_PER_PAGE);

            const tbody = document.getElementById('reportTableBody');
            if (totalItems === 0 && openingBalance === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-slate-400">Siswa ini belum memiliki riwayat transaksi tabungan pada periode ini</td></tr>`;
                document.getElementById('reportTableFooter').innerHTML = '';
                renderPaginationControls('reportPagination', 1, 0, 0, 'changeReportPage');
                return;
            }

            let tableRowsHtml = '';

            if (startIndex === 0 && startDate && openingBalance !== 0) {
                tableRowsHtml += `
                    <tr class="bg-slate-50 font-semibold italic text-slate-600">
                        <td class="p-2.5 border-b border-slate-200 text-center font-mono">-</td>
                        <td class="p-2.5 border-b border-slate-200">${startDate}</td>
                        <td class="p-2.5 border-b border-slate-200"><span class="px-2 py-0.5 text-[10px] font-extrabold rounded bg-slate-200 text-slate-700">SALDO AWAL</span></td>
                        <td class="p-2.5 border-b border-slate-200 text-right">-</td>
                        <td class="p-2.5 border-b border-slate-200 text-right">-</td>
                        <td class="p-2.5 border-b border-slate-200 text-right font-bold text-slate-900">${formatRp(openingBalance)}</td>
                        <td class="p-2.5 border-b border-slate-200 text-slate-500">Saldo Bawaan Sebelum Periode</td>
                    </tr>
                `;
            }

            pagedRows.forEach(item => {
                const t = item.tx;
                const amt = Number(t.amount || 0);

                tableRowsHtml += `
                    <tr>
                        <td class="p-2.5 border-b border-slate-100 text-center font-mono">${item.index}</td>
                        <td class="p-2.5 border-b border-slate-100 font-semibold text-slate-800">${t.date}</td>
                        <td class="p-2.5 border-b border-slate-100">
                            <span class="px-2 py-0.5 text-[10px] font-extrabold rounded ${t.type === 'SETOR' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">
                                ${t.type === 'SETOR' ? '+ SETOR' : '- TARIK'}
                            </span>
                        </td>
                        <td class="p-2.5 border-b border-slate-100 text-right font-bold text-emerald-600">${t.type === 'SETOR' ? formatRp(amt) : '-'}</td>
                        <td class="p-2.5 border-b border-slate-100 text-right font-bold text-rose-600">${t.type === 'TARIK' ? formatRp(amt) : '-'}</td>
                        <td class="p-2.5 border-b border-slate-100 text-right font-bold text-slate-900">${formatRp(item.runBal)}</td>
                        <td class="p-2.5 border-b border-slate-100 text-slate-500">${t.note || '-'}</td>
                    </tr>
                `;
            });

            tbody.innerHTML = tableRowsHtml;

            document.getElementById('reportTableFooter').innerHTML = `
                <tr>
                    <td colspan="3" class="p-2.5 text-right font-bold">AKUMULASI PERIODE INI:</td>
                    <td class="p-2.5 text-right font-extrabold text-emerald-700">+${formatRp(totalSetor)}</td>
                    <td class="p-2.5 text-right font-extrabold text-rose-700">-${formatRp(totalTarik)}</td>
                    <td class="p-2.5 text-right font-extrabold text-indigo-700">${formatRp(endingBalance)}</td>
                    <td class="p-2.5"></td>
                </tr>
            `;

            renderPaginationControls('reportPagination', currentPageReport, totalPages, totalItems, 'changeReportPage');
        }

        // RENDER PARKING REPORT WITH 10 ROWS PER PAGE
        function renderParkingReport(startDate, endDate) {
            let filtered = [...parkingLogs];
            if (startDate) filtered = filtered.filter(p => p.date >= startDate);
            if (endDate) filtered = filtered.filter(p => p.date <= endDate);

            const totalRev = filtered.reduce((a, b) => a + Number(b.amount || 0), 0);
            const totalExp = filtered.reduce((a, b) => a + Number(b.expense || 0), 0);
            const netPark = totalRev - totalExp;

            document.getElementById('reportSummaryMetrics').innerHTML = `
                <div class="p-3 bg-emerald-50 rounded-lg border border-emerald-200">
                    <p class="text-[11px] font-semibold text-emerald-700">Total Pendapatan</p>
                    <p class="text-sm font-bold text-emerald-900">${formatRp(totalRev)}</p>
                </div>
                <div class="p-3 bg-rose-50 rounded-lg border border-rose-200">
                    <p class="text-[11px] font-semibold text-rose-700">Total Pengeluaran</p>
                    <p class="text-sm font-bold text-rose-900">${formatRp(totalExp)}</p>
                </div>
                <div class="p-3 bg-indigo-50 rounded-lg border border-indigo-200">
                    <p class="text-[11px] font-semibold text-indigo-700">Hasil Bersih (Net)</p>
                    <p class="text-sm font-bold text-indigo-900">${formatRp(netPark)}</p>
                </div>
            `;

            document.getElementById('reportTableHeader').innerHTML = `
                <tr>
                    <th class="p-2.5 border-b border-slate-300">Tanggal</th>
                    <th class="p-2.5 border-b border-slate-300 text-right">Pendapatan</th>
                    <th class="p-2.5 border-b border-slate-300 text-right">Pengeluaran</th>
                    <th class="p-2.5 border-b border-slate-300">Catatan</th>
                </tr>
            `;

            const totalItems = filtered.length;
            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

            if (currentPageReport > totalPages) currentPageReport = totalPages;

            const startIndex = (currentPageReport - 1) * ITEMS_PER_PAGE;
            const pagedLogs = filtered.slice(startIndex, startIndex + ITEMS_PER_PAGE);

            const tbody = document.getElementById('reportTableBody');
            if (totalItems === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400">Tidak ada data rekap parkir untuk periode ini</td></tr>`;
                document.getElementById('reportTableFooter').innerHTML = '';
                renderPaginationControls('reportPagination', 1, 0, 0, 'changeReportPage');
                return;
            }

            tbody.innerHTML = pagedLogs.map(p => `
                <tr>
                    <td class="p-2.5 border-b border-slate-100 font-semibold">${p.date}</td>
                    <td class="p-2.5 border-b border-slate-100 text-right font-bold text-emerald-600">${formatRp(p.amount)}</td>
                    <td class="p-2.5 border-b border-slate-100 text-right font-bold text-rose-600">${formatRp(p.expense)}</td>
                    <td class="p-2.5 border-b border-slate-100">${p.note || '-'}</td>
                </tr>
            `).join('');

            document.getElementById('reportTableFooter').innerHTML = `
                <tr>
                    <td class="p-2.5 text-right font-bold">TOTAL NET:</td>
                    <td class="p-2.5 text-right font-extrabold text-emerald-700">${formatRp(totalRev)}</td>
                    <td class="p-2.5 text-right font-extrabold text-rose-700">${formatRp(totalExp)}</td>
                    <td class="p-2.5 font-bold text-indigo-700">Bersih: ${formatRp(netPark)}</td>
                </tr>
            `;

            renderPaginationControls('reportPagination', currentPageReport, totalPages, totalItems, 'changeReportPage');
        }

        function exportReportExcel() {
            const type = document.getElementById('repType').value;
            const startDate = document.getElementById('repStartDate').value;
            const endDate = document.getElementById('repEndDate').value;

            let dataToExport = [];
            let fileName = 'Laporan.xlsx';

            if (type === 'SAVINGS') {
                let filtered = [...savingsTransactions];
                if (startDate) filtered = filtered.filter(t => t.date >= startDate);
                if (endDate) filtered = filtered.filter(t => t.date <= endDate);

                dataToExport = filtered.map(t => {
                    const stud = students.find(s => s.nis === t.studentNis);
                    return {
                        'Tanggal': t.date,
                        'NIS': t.studentNis,
                        'Nama Siswa': t.studentName,
                        'Kelas': stud ? stud.class : '-',
                        'Jenis': t.type,
                        'Nominal (Rp)': t.amount,
                        'Catatan': t.note || ''
                    };
                });
                fileName = `Laporan_Tabungan_${startDate || 'all'}_s.d_${endDate || 'all'}.xlsx`;
            } else if (type === 'STUDENT') {
                const nis = document.getElementById('repStudentSelect')?.value;
                const student = students.find(s => s.nis === nis);
                if (!student) {
                    showToast('Pilih siswa terlebih dahulu untuk diekspor!', 'error');
                    return;
                }

                let allStudentTxs = savingsTransactions.filter(t => t.studentNis === student.nis)
                    .sort((a, b) => new Date(a.date) - new Date(b.date));

                let openingBalance = 0;
                if (startDate) {
                    const priorTxs = allStudentTxs.filter(t => t.date < startDate);
                    openingBalance = priorTxs.reduce((acc, t) => acc + (t.type === 'SETOR' ? Number(t.amount || 0) : -Number(t.amount || 0)), 0);
                }

                let filtered = allStudentTxs;
                if (startDate) filtered = filtered.filter(t => t.date >= startDate);
                if (endDate) filtered = filtered.filter(t => t.date <= endDate);

                let runBal = openingBalance;

                dataToExport = filtered.map((t, idx) => {
                    const amt = Number(t.amount || 0);
                    if (t.type === 'SETOR') runBal += amt;
                    else runBal -= amt;

                    return {
                        'No': idx + 1,
                        'Tanggal': t.date,
                        'NIS': student.nis,
                        'Nama Siswa': student.name,
                        'Kelas': student.class,
                        'Jenis Transaksi': t.type,
                        'Setor (Rp)': t.type === 'SETOR' ? amt : 0,
                        'Tarik (Rp)': t.type === 'TARIK' ? amt : 0,
                        'Saldo Kumulatif (Rp)': runBal,
                        'Keterangan': t.note || ''
                    };
                });

                const cleanName = student.name.replace(/[^a-zA-Z0-9]/g, '_');
                fileName = `Rekap_Tabungan_${student.nis}_${cleanName}.xlsx`;
            } else {
                let filtered = [...parkingLogs];
                if (startDate) filtered = filtered.filter(p => p.date >= startDate);
                if (endDate) filtered = filtered.filter(p => p.date <= endDate);

                dataToExport = filtered.map(p => ({
                    'Tanggal': p.date,
                    'Pendapatan (Rp)': p.amount,
                    'Pengeluaran (Rp)': p.expense,
                    'Catatan': p.note || ''
                }));
                fileName = `Laporan_Parkir_${startDate || 'all'}_s.d_${endDate || 'all'}.xlsx`;
            }

            if (dataToExport.length === 0) {
                showToast('Tidak ada data untuk diekspor!', 'error');
                return;
            }

            const ws = XLSX.utils.json_to_sheet(dataToExport);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Laporan");
            XLSX.writeFile(wb, fileName);
            showToast('Laporan berhasil diekspor ke Excel!', 'success');
        }

        function printReport() {
            const type = document.getElementById('repType').value;
            const startDate = document.getElementById('repStartDate').value;
            const endDate = document.getElementById('repEndDate').value;

            // Render unpaginated full dataset for printing
            if (type === 'SAVINGS') {
                renderSavingsReport(startDate, endDate, true);
            } else if (type === 'STUDENT') {
                renderStudentRecapReport(startDate, endDate, true);
            } else {
                renderParkingReport(startDate, endDate, true);
            }

            safeLucide();

            // Restore paginated view only after printing process finishes
            const restorePaginatedView = () => {
                window.removeEventListener('afterprint', restorePaginatedView);
                applyReportFilter();
            };
            window.addEventListener('afterprint', restorePaginatedView);

            // Trigger browser print dialog with slight delay to ensure full DOM render
            setTimeout(() => {
                window.print();
            }, 200);
        }
    </script>
