            openConfirmModal('Hapus Transaksi Tabungan', `Apakah Anda yakin ingin menghapus transaksi ${tx.type} Rp ${Number(tx.amount || 0).toLocaleString('id-ID')} atas nama ${tx.studentName}?`, () => {
                savingsTransactions = savingsTransactions.filter(t => t.id !== id);
