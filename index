        function handleExcelUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(evt) {
                try {
                    const data = new Uint8Array(evt.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];
                    const json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                    processExcelData(json);
                } catch (err) {
                    showToast('Gagal membaca berkas Excel!', 'error');
                }
            };
            reader.readAsArrayBuffer(file);
            e.target.value = '';
        }

        function processExcelData(rows) {
            if (rows.length <= 1) {
                showToast('File Excel kosong atau tidak sesuai format!', 'error');
                return;
            }

            tempImportData = [];
            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                if (!row || row.length === 0) continue;

                const name = String(row[1] || '').trim();
                const jk = String(row[2] || 'L').trim().toUpperCase();
                const nis = String(row[3] || '').trim();
                const cls = String(row[4] || '').trim();

                if (nis && name) {
                    tempImportData.push({ nis, name, jk: jk === 'P' ? 'P' : 'L', class: cls || 'X' });
                }
            }

            if (tempImportData.length === 0) {
                showToast('Tidak ada data siswa valid ditemukan dalam Excel!', 'error');
                return;
            }

            const previewTbody = document.getElementById('excelPreviewTableBody');
            previewTbody.innerHTML = tempImportData.map(s => `
                <tr>
                    <td class="p-2 border border-slate-200 font-mono">${s.nis}</td>
                    <td class="p-2 border border-slate-200 font-bold">${s.name}</td>
                    <td class="p-2 border border-slate-200">${s.jk}</td>
                    <td class="p-2 border border-slate-200">${s.class}</td>
                </tr>
            `).join('');

            document.getElementById('excelImportCount').innerText = `${tempImportData.length} data siswa siap diimpor`;
            document.getElementById('excelPreviewModal').classList.remove('hidden');
        }

