        const getTodayIsoDate = () => {
            const d = new Date();
            return new Date(d.getTime() - (d.getTimezoneOffset() * 60000)).toISOString().split('T')[0];
        };

        function setupDateInputs() {
            const today = getTodayIsoDate();
            const dateInputIds = ['txDate', 'prkDate'];
            dateInputIds.forEach(id => {
                const el = document.getElementById(id);
                if (el && !el.value) {
                    el.value = today;
                }
            });
        }

        function formatRupiahInput(value) {
            if (!value) return '';
            const cleanNum = value.toString().replace(/\D/g, '');
            if (!cleanNum) return '';
            return Number(cleanNum).toLocaleString('id-ID');
        }

        function parseRupiahInput(value) {
            if (!value) return 0;
            return Number(value.toString().replace(/\D/g, '')) || 0;
        }

        function setupCurrencyInputs() {
            ['txAmount', 'prkAmount', 'prkExpense'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener('input', (e) => {
                        e.target.value = formatRupiahInput(e.target.value);
                    });
                }
            });
        }

        function recalculateStudentBalances() {
            students.forEach(s => {
                const txs = savingsTransactions.filter(t => t.studentNis === s.nis);
                s.balance = txs.reduce((acc, t) => acc + (t.type === 'SETOR' ? Number(t.amount || 0) : -Number(t.amount || 0)), 0);
            });
        }

        // REUSABLE PAGINATION CONTROLLER RENDERER
        function renderPaginationControls(containerId, currentPage, totalPages, totalItems, changePageFnName) {
            const el = document.getElementById(containerId);
            if (!el) return;

            if (totalItems === 0) {
                el.innerHTML = `<span class="text-slate-400 font-medium">Menampilkan 0 data</span>`;
                return;
            }

            if (totalPages <= 1) {
                el.innerHTML = `<span class="text-slate-500 font-medium">Menampilkan ${totalItems} data</span>`;
                return;
            }

            const startIdx = (currentPage - 1) * ITEMS_PER_PAGE + 1;
            const endIdx = Math.min(currentPage * ITEMS_PER_PAGE, totalItems);

            let pageBtns = '';
            for (let p = 1; p <= totalPages; p++) {
                if (totalPages > 7) {
                    if (p !== 1 && p !== totalPages && Math.abs(p - currentPage) > 1) {
                        if (p === 2 && currentPage > 3) {
                            pageBtns += `<span class="px-1 text-slate-400">...</span>`;
                            continue;
                        }
                        if (p === totalPages - 1 && currentPage < totalPages - 2) {
                            pageBtns += `<span class="px-1 text-slate-400">...</span>`;
                            continue;
                        }
                        if (Math.abs(p - currentPage) > 1) continue;
                    }
                }
                const isActive = p === currentPage;
                pageBtns += `
                    <button onclick="${changePageFnName}(${p})" class="w-7 h-7 flex items-center justify-center text-xs font-bold rounded-lg transition-all ${isActive ? 'bg-indigo-600 text-white shadow-sm shadow-indigo-500/30' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'}">
                        ${p}
                    </button>
                `;
            }

            el.innerHTML = `
                <span class="text-slate-500 font-medium">Menampilkan <strong class="text-slate-800">${startIdx}-${endIdx}</strong> dari <strong class="text-slate-800">${totalItems}</strong> data</span>
                <div class="flex items-center gap-1.5">
