        function handleSavingsSubmit(e) {
            e.preventDefault();
            const nis = document.getElementById('txStudentSelect').value;
            const type = document.querySelector('input[name="txType"]:checked').value;
            const amount = parseRupiahInput(document.getElementById('txAmount').value);
            const date = document.getElementById('txDate').value || getTodayIsoDate();
            const note = document.getElementById('txNote').value.trim();

            const student = students.find(s => s.nis === nis);
            if (!student) {
                showToast('Pilih siswa terlebih dahulu!', 'error');
                return;
            }

            if (amount <= 0) {
                showToast('Nominal harus lebih dari 0!', 'error');
                return;
            }

            if (type === 'TARIK' && (student.balance || 0) < amount) {
                showToast('Saldo siswa tidak mencukupi untuk penarikan ini!', 'error');
                return;
            }

            if (type === 'SETOR') {
                student.balance = (Number(student.balance) || 0) + amount;
            } else {
                student.balance = (Number(student.balance) || 0) - amount;
            }

            const newTx = {
                id: 'tx_' + Date.now(),
                studentNis: student.nis,
                studentName: student.name,
                type: type,
                amount: amount,
                date: date,
                note: note || (type === 'SETOR' ? 'Setoran tunai' : 'Penarikan tunai')
            };

            savingsTransactions.push(newTx);
            recalculateStudentBalances();
            saveDataToGoogleSheets();

            document.getElementById('savingsForm').reset();
            setupDateInputs();
            renderAllViews();
            renderDashboardChart();

            showToast(`Transaksi ${type} Rp ${amount.toLocaleString('id-ID')} berhasil disimpan!`, 'success');
        }

        // RENDER SAVINGS WITH 10 ROWS PER PAGE (PAGINATED GROUPS)
        function renderSavings() {
            const tbody = document.getElementById('savingsHistoryBody');
            if (!tbody) return;

            const search = (document.getElementById('searchSavingsInput')?.value || '').toLowerCase();
            let filtered = [...savingsTransactions].reverse();

            if (search) {
                filtered = filtered.filter(t => t.studentNis.toLowerCase().includes(search) || t.studentName.toLowerCase().includes(search));
            }

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-slate-400">Tidak ada riwayat transaksi</td></tr>`;
                renderPaginationControls('savingsPagination', 1, 0, 0, 'changeSavingsPage');
                return;
            }

            const grouped = {};
            filtered.forEach(t => {
                if (!grouped[t.studentNis]) {
                    grouped[t.studentNis] = {
                        studentName: t.studentName,
                        transactions: []
                    };
                }
                grouped[t.studentNis].transactions.push(t);
            });

            const groupNises = Object.keys(grouped);
            const totalItems = groupNises.length;
            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

            if (currentPageSavings > totalPages) currentPageSavings = totalPages;

            const startIndex = (currentPageSavings - 1) * ITEMS_PER_PAGE;
            const pagedNises = groupNises.slice(startIndex, startIndex + ITEMS_PER_PAGE);

            let html = '';
            for (const nis of pagedNises) {
                const group = grouped[nis];
                const stud = students.find(s => s.nis === nis);
                const cls = stud ? stud.class : '-';
                const safeNis = nis.replace(/\W/g, '');
                const isExpanded = expandedSavingsGroups.has(safeNis);
                const studentBalance = stud ? stud.balance : group.transactions.reduce((acc, t) => acc + (t.type === 'SETOR' ? Number(t.amount || 0) : -Number(t.amount || 0)), 0);

                html += `
                <tr class="hover:bg-slate-100 cursor-pointer border-b border-slate-200 bg-slate-50 transition-colors" onclick="toggleSavingsGroup('${safeNis}')">
                    <td class="p-3 text-center w-10">
                        <i data-lucide="chevron-down" id="icon_group_${safeNis}" class="w-4 h-4 text-slate-500 transition-transform ${isExpanded ? '' : '-rotate-90'} inline-block"></i>
                    </td>
                    <td class="p-3">
                        <div class="font-bold text-slate-900">${group.studentName}</div>
                        <div class="text-[10px] text-slate-500">NIS: ${nis}</div>
                    </td>
                    <td class="p-3 font-semibold text-slate-700">${cls}</td>
                    <td class="p-3">
                        <span class="px-2.5 py-1 text-[10px] font-bold text-indigo-700 bg-indigo-100/70 rounded-md border border-indigo-200">
                            ${group.transactions.length} Riwayat Transaksi
                        </span>
                    </td>
                    <td class="p-3 text-right font-bold text-emerald-600">
                        ${formatRp(studentBalance)}
                    </td>
                    <td class="p-3"></td>
                    <td class="p-3"></td>
                </tr>
                `;

                group.transactions.forEach(t => {
                    html += `
                    <tr class="hover:bg-slate-50 child-group-${safeNis} ${isExpanded ? '' : 'hidden'} border-b border-slate-100">
                        <td class="p-3 pl-8 font-semibold text-slate-700 text-[11px] border-l-2 border-indigo-200">${t.date}</td>
                        <td class="p-3 text-slate-400 text-[10px] italic">↳ Detail Trx</td>
                        <td class="p-3 text-slate-400 text-[10px]">-</td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 text-[10px] font-extrabold rounded ${t.type === 'SETOR' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">
                                ${t.type}
                            </span>
                        </td>
                        <td class="p-3 text-right font-bold ${t.type === 'SETOR' ? 'text-emerald-600' : 'text-rose-600'}">
                            ${t.type === 'SETOR' ? '+' : '-'}${formatRp(t.amount)}
                        </td>
                        <td class="p-3 text-slate-500 text-[11px]">${t.note || '-'}</td>
                        <td class="p-3 text-center">
                            <button onclick="deleteSavings('${t.id}')" class="p-1 text-slate-400 hover:text-rose-600" title="Hapus Transaksi"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                        </td>
                    </tr>
                    `;
                });
            }

            tbody.innerHTML = html;
            renderPaginationControls('savingsPagination', currentPageSavings, totalPages, totalItems, 'changeSavingsPage');
            safeLucide();
        }

        function toggleSavingsGroup(safeNis) {
            const rows = document.querySelectorAll(`.child-group-${safeNis}`);
            const icon = document.getElementById(`icon_group_${safeNis}`);
            let isHidden = false;
            
            rows.forEach(row => {
                if (row.classList.contains('hidden')) {
                    row.classList.remove('hidden');
                    isHidden = true;
                } else {
                    row.classList.add('hidden');
                }
            });

            if (isHidden) {
                expandedSavingsGroups.add(safeNis);
                if (icon) icon.classList.remove('-rotate-90');
            } else {
                expandedSavingsGroups.delete(safeNis);
                if (icon) icon.classList.add('-rotate-90');
            }
        }

