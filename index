<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tabungan Siswa & Parkir</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SheetJS CDN for Excel Import/Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 600;
            font-size: 0.8125rem; /* Character font bold & small (13px) */
        }
        input, select, button, textarea {
            font-weight: 600;
        }

        /* GLOBAL ANIMATIONS FOR ALL BUTTONS & INTERACTIVE ELEMENTS */
        button, input[type="submit"], input[type="button"], label.cursor-pointer, .nav-btn {
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), 
                        background-color 0.2s ease, 
                        box-shadow 0.2s ease, 
                        filter 0.15s ease !important;
            will-change: transform;
        }

        /* Hover Effect: Soft Lift & Brightness Boost */
        button:hover, input[type="submit"]:hover, input[type="button"]:hover, label.cursor-pointer:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
        }

        /* Active / Click Effect: Press down & subtle scale feedback */
        button:active, input[type="submit"]:active, input[type="button"]:active, label.cursor-pointer:active {
            transform: translateY(1px) scale(0.96) !important;
            filter: brightness(0.95);
        }

        /* Smooth pulse animation for status badges & sync icon */
        .animate-spin {
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        @media print {
            html, body {
                height: auto !important;
                min-height: 0 !important;
                overflow: visible !important;
                background: #fff !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            body * {
                visibility: hidden;
            }
            div, main, section, aside, header {
                overflow: visible !important;
                height: auto !important;
                max-height: none !important;
                position: static !important;
            }
            #printableReportArea, #printableReportArea * {
                visibility: visible;
            }
            #printableReportArea {
                position: static !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                box-shadow: none !important;
                border: none !important;
                overflow: visible !important;
                display: block !important;
            }
            .no-print {
                display: none !important;
            }
            table {
                width: 100% !important;
                page-break-inside: auto;
                border-collapse: collapse;
            }
            tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }
            thead {
                display: table-header-group;
            }
            tfoot {
                display: table-footer-group;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col md:flex-row">

    <!-- LOGIN OVERLAY / SCREEN -->
    <div id="loginOverlay" class="fixed inset-0 bg-slate-900/90 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md p-6 sm:p-8 space-y-6">
            <div class="text-center space-y-2">
                <div class="w-14 h-14 bg-indigo-600 rounded-2xl mx-auto flex items-center justify-center text-white font-black text-2xl shadow-lg shadow-indigo-500/30">
                    T
                </div>
                <h1 class="text-xl font-bold text-slate-900 tracking-tight">Tabungan Siswa & Parkir</h1>
                <p class="text-xs text-slate-500 font-medium">Masuk untuk mengakses sistem tabungan & parkir</p>
            </div>

            <form id="loginForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Username</label>
                    <input type="text" id="loginUsername" required placeholder="Masukkan username" class="w-full text-xs p-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
                    <input type="password" id="loginPassword" required placeholder="••••••••" class="w-full text-xs p-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs py-3 rounded-xl shadow-md shadow-indigo-600/20 transition-all">
                    Masuk ke Sistem
                </button>
            </form>

            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-[11px] text-slate-500 space-y-1">
                <p class="font-bold text-slate-700">Akses Demo Default:</p>
                <p>Username: <code class="bg-slate-200 px-1 py-0.5 rounded font-mono text-slate-800">admin</code> | Password: <code class="bg-slate-200 px-1 py-0.5 rounded font-mono text-slate-800">admin123</code></p>
            </div>
        </div>
    </div>

    <!-- SIDEBAR NAVIGATION -->
    <aside id="sidebar" class="w-full md:w-64 bg-slate-900 text-slate-300 flex flex-col flex-shrink-0 transition-all duration-300 z-30 fixed md:relative inset-y-0 -translate-x-full md:translate-x-0 no-print">
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-indigo-500/30">
                    T
                </div>
                <div>
                    <h1 class="font-bold text-white text-base tracking-tight leading-none">Tabungan Siswa & Parkir</h1>
                    <p class="text-[11px] text-slate-400 mt-1 font-medium" id="sideRoleText">Panel Petugas Sekolah</p>
                </div>
            </div>
            <button id="toggleSidebarBtn" class="md:hidden text-slate-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
            <button onclick="showSection('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-white bg-indigo-600 transition-all">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                <span>Dashboard Utama</span>
            </button>

            <button onclick="showSection('savings')" id="nav-savings" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="wallet" class="w-4 h-4"></i>
                <span>Transaksi Tabungan</span>
            </button>

            <button onclick="showSection('parking')" id="nav-parking" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="parking-square" class="w-4 h-4"></i>
                <span>Pencatatan Parkir</span>
            </button>

            <button onclick="showSection('reports')" id="nav-reports" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="file-text" class="w-4 h-4"></i>
                <span>Laporan Keuangan</span>
            </button>

            <button onclick="showSection('users')" id="nav-users" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="user-check" class="w-4 h-4"></i>
                <span>Kelola User / Admin</span>
            </button>

            <button onclick="showSection('students')" id="nav-students" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="users" class="w-4 h-4"></i>
                <span>Kelola Data Siswa</span>
            </button>
        </nav>

        <div class="p-4 border-t border-slate-800 text-xs text-slate-400 space-y-2">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" id="gasStatusDot"></span>
                <span id="gasStatusText" class="font-medium text-emerald-400">Google Sheets Fullspeed Sync (5s)</span>
            </div>
            <p class="text-slate-500 text-[11px]">Tabungan Siswa & Parkir v4.0 • Ultra Fast Real-Time</p>
        </div>
    </aside>

    <!-- MAIN CONTENT WRAPPER -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- TOPBAR -->
        <header class="bg-white border-b border-slate-200 px-6 py-3.5 flex items-center justify-between no-print sticky top-0 z-20">
            <div class="flex items-center gap-3">
                <button id="openSidebarBtn" class="md:hidden text-slate-600 hover:text-slate-900">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
                <h2 id="pageTitle" class="text-sm font-bold text-slate-900 tracking-tight">Dashboard Utama</h2>
            </div>

            <div class="flex items-center gap-4">
                <button onclick="fetchDataFromGoogleSheets(false)" class="flex items-center gap-2 text-xs font-medium text-slate-600 hover:text-indigo-600 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition-all" title="Sinkronkan dengan Google Sheets">
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5" id="headerSyncIcon"></i>
                    <span class="hidden sm:inline">Sync Data</span>
                </button>
                <div class="h-4 w-px bg-slate-200"></div>
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-xs" id="userAvatar">
                        AD
                    </div>
                    <div class="hidden sm:block text-left">
                        <p class="text-xs font-semibold text-slate-900 leading-none" id="topUserName">Admin</p>
                        <p class="text-[10px] text-slate-500 mt-0.5" id="topUserRole">Administrator</p>
                    </div>
                    <button onclick="handleLogout()" class="p-1.5 text-slate-400 hover:text-rose-600 transition-all" title="Keluar / Logout">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- CONTENT SECTIONS -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6">

            <!-- 1. DASHBOARD UTAMA -->
            <section id="sec-dashboard" class="space-y-6">
                <!-- STATS CARDS -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                            <i data-lucide="wallet" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Total Saldo Tabungan</p>
                            <h3 class="text-lg font-bold text-slate-900" id="dashTotalSavings">Rp 0</h3>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                            <i data-lucide="users" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Siswa Terdaftar</p>
                            <h3 class="text-lg font-bold text-slate-900" id="dashTotalStudents">0</h3>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                            <i data-lucide="parking-square" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Total Rekap Parkir</p>
                            <h3 class="text-lg font-bold text-slate-900" id="dashTotalParking">Rp 0</h3>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                            <i data-lucide="arrow-left-right" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Transaksi Hari Ini</p>
                            <h3 class="text-lg font-bold text-slate-900" id="dashTodayTx">0</h3>
                        </div>
                    </div>
                </div>

                <!-- CHART SECTION -->
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-bold text-slate-900">Grafik Tren Setor vs Tarik (7 Hari Terakhir)</h3>
                    </div>
                    <div class="h-64 relative">
                        <canvas id="savingsChart"></canvas>
                    </div>
                </div>

                <!-- RECENT TRANSACTIONS TABLE -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                        <h3 class="text-sm font-bold text-slate-900">Aktivitas Transaksi Tabungan Terbaru</h3>
                        <button onclick="showSection('savings')" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">Lihat Semua</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px]">
                                <tr>
                                    <th class="p-3">Tanggal</th>
                                    <th class="p-3">NIS</th>
                                    <th class="p-3">Nama Siswa</th>
                                    <th class="p-3">Jenis</th>
                                    <th class="p-3 text-right">Nominal</th>
                                </tr>
                            </thead>
                            <tbody id="dashRecentTxBody" class="divide-y divide-slate-100 font-medium">
                                <tr><td colspan="5" class="p-4 text-center text-slate-400">Belum ada transaksi</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 2. TRANSAKSI TABUNGAN -->
            <section id="sec-savings" class="hidden space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- FORM TRANSACTION -->
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
                        <h3 class="text-sm font-bold text-slate-900 pb-2 border-b border-slate-100">Catat Transaksi Tabungan</h3>
                        <form id="savingsForm" class="space-y-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Cari / Pilih Siswa *</label>
                                <div class="space-y-1.5">
                                    <input type="text" id="txStudentSearch" oninput="populateStudentDropdowns()" placeholder="Ketik nama, NIS, atau kelas siswa..." class="w-full text-xs p-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 font-medium">
                                    <select id="txStudentSelect" required class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                                        <option value="">-- Pilih Siswa --</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Jenis Transaksi *</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <label class="flex items-center justify-center p-2 rounded-lg border border-slate-200 text-xs font-bold cursor-pointer transition-all bg-emerald-50 border-emerald-500 text-emerald-700" id="labelSetor">
                                        <input type="radio" name="txType" value="SETOR" checked onchange="handleSavingsTypeToggle()" class="hidden">
                                        + SETOR TUNAI
                                    </label>
                                    <label class="flex items-center justify-center p-2 rounded-lg border border-slate-200 text-xs font-bold cursor-pointer transition-all text-slate-600" id="labelTarik">
                                        <input type="radio" name="txType" value="TARIK" onchange="handleSavingsTypeToggle()" class="hidden">
                                        - TARIK TUNAI
                                    </label>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Nominal (Rp) *</label>
                                <input type="text" inputmode="numeric" id="txAmount" required placeholder="10.000" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 font-semibold">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Transaksi</label>
                                <input type="date" id="txDate" required class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Catatan / Keterangan</label>
                                <input type="text" id="txNote" placeholder="Contoh: Setoran mingguan" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500">
                            </div>

                            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs py-2.5 rounded-lg shadow-md transition-all flex items-center justify-center gap-2">
                                <i data-lucide="check-circle" class="w-4 h-4"></i>
                                <span>Proses Transaksi</span>
                            </button>
                        </form>
                    </div>

                    <!-- SAVINGS HISTORY TABLE WITH PAGINATION -->
                    <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between">
                        <div>
                            <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                                <h3 class="text-sm font-bold text-slate-900">Riwayat Transaksi Tabungan</h3>
                                <input type="text" id="searchSavingsInput" onkeyup="onSearchSavingsChange()" placeholder="Cari NIS / Nama..." class="text-xs p-1.5 px-3 rounded-lg border border-slate-300">
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs">
                                    <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px]">
                                        <tr>
                                            <th class="p-3 w-10 text-center"></th>
                                            <th class="p-3">Siswa</th>
                                            <th class="p-3">Kelas</th>
                                            <th class="p-3">Jumlah Trx</th>
                                            <th class="p-3 text-right">Saldo Utama</th>
                                            <th class="p-3">Catatan</th>
                                            <th class="p-3 text-center">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody id="savingsHistoryBody" class="divide-y divide-slate-100 font-medium">
                                        <tr><td colspan="7" class="p-4 text-center text-slate-400">Memuat data transaksi...</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- PAGINATION CONTAINER -->
                        <div id="savingsPagination" class="p-3 border-t border-slate-100 bg-slate-50 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs font-medium text-slate-600"></div>
                    </div>
                </div>
            </section>

            <!-- 3. PENCATATAN PARKIR -->
            <section id="sec-parking" class="hidden space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- FORM ENTRY PARKIR HARIAN -->
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
                        <h3 class="text-sm font-bold text-slate-900 pb-2 border-b border-slate-100">Pencatatan Rekap Parkir Harian</h3>
                        <form id="parkingForm" class="space-y-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Rekap *</label>
                                <input type="date" id="prkDate" required class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Pendapatan Parkir (Rp) *</label>
                                <input type="text" inputmode="numeric" id="prkAmount" required placeholder="50.000" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 font-semibold">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Pengeluaran Parkir (Rp)</label>
                                <input type="text" inputmode="numeric" id="prkExpense" placeholder="10.000" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 font-semibold">
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Catatan / Keterangan</label>
                                <input type="text" id="prkNote" placeholder="Contoh: Cetak karcis & konsumsi petugas" class="w-full text-xs p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500">
                            </div>

                            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-2.5 rounded-lg shadow-md transition-all flex items-center justify-center gap-2">
                                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                                <span>Simpan Record Parkir</span>
                            </button>
                        </form>
                    </div>

                    <!-- REKAP PARKIR TABLE WITH PAGINATION -->
                    <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between">
                        <div>
                            <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                                <h3 class="text-sm font-bold text-slate-900">Riwayat Rekapitulasi Parkir Harian</h3>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs">
                                    <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px]">
                                        <tr>
                                            <th class="p-3">Tanggal</th>
                                            <th class="p-3 text-right">Pendapatan</th>
                                            <th class="p-3 text-right">Pengeluaran</th>
                                            <th class="p-3">Catatan / Keterangan</th>
