        function renderDashboardChart() {
            const ctx = document.getElementById('savingsChart');
            if (!ctx) return;

            const labels = [];
            const deposits = [];
            const withdrawals = [];

            for (let i = 6; i >= 0; i--) {
                const d = new Date();
                d.setDate(d.getDate() - i);
                
                const dateStr = new Date(d.getTime() - (d.getTimezoneOffset() * 60000)).toISOString().split('T')[0];
                labels.push(dateStr);

                const dayTxs = savingsTransactions.filter(t => t.date === dateStr);
                const daySetor = dayTxs.filter(t => t.type === 'SETOR').reduce((a, b) => a + Number(b.amount || 0), 0);
                const dayTarik = dayTxs.filter(t => t.type === 'TARIK').reduce((a, b) => a + Number(b.amount || 0), 0);

                deposits.push(daySetor);
                withdrawals.push(dayTarik);
            }

            if (savingsChartInstance) {
                savingsChartInstance.destroy();
            }

            if (typeof Chart !== 'undefined') {
                savingsChartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Setor Tunai (Rp)',
                                data: deposits,
                                backgroundColor: '#10b981',
                                borderRadius: 6
                            },
                            {
                                label: 'Tarik Tunai (Rp)',
                                data: withdrawals,
                                backgroundColor: '#f43f5e',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top', labels: { font: { size: 11, family: 'Plus Jakarta Sans' } } }
                        },
                        scales: {
                            y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        }

